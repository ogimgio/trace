{
  "manifest_version": 3,
  "name": "TRACE",
  "version": "0.1.0",
  "description": "Condividi la tua cronologia di navigazione in modo consapevole e ricevi TRACE su Solana.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TRACE",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["alarms", "storage"],
  "optional_permissions": ["history"],
  "host_permissions": ["https://trace-rewards.vercel.app/*", "http://localhost:8787/*"]
}
